        <mxCell id="c3" value="Страница «Курьеры и транспорт»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="305" y="330" width="210" height="45" as="geometry"/>
