<mxfile host="app.diagrams.net">
  <diagram name="Архитектура" id="logistics-arch">
    <mxGraphModel dx="1300" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Система оценки эффективности логистических маршрутов и доставки" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="900" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="users" value="Пользователи" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="170" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="u1" value="Администратор&lt;br&gt;&lt;i&gt;ADMIN&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="130" height="60" as="geometry"/>
        </mxCell>
