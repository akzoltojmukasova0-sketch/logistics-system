        <mxCell id="u3" value="Курьер&lt;br&gt;&lt;i&gt;COURIER&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="130" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="Клиент (Presentation Layer)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="260" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="c0" value="React SPA&lt;br&gt;(Vite + TypeScript)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="305" y="125" width="210" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="Страница «Маршруты»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
