        <mxCell id="metrics" value="&lt;b&gt;Показатели эффективности:&lt;/b&gt; отклонение факта от плана (время, расстояние) · стоимость километра · доля доставок в срок" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=13;" vertex="1" parent="1">
